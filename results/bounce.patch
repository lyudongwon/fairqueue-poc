diff --git a/gateway/bounce.go b/gateway/bounce.go
new file mode 100644
index 0000000..e9826cb
--- /dev/null
+++ b/gateway/bounce.go
@@ -0,0 +1,123 @@
+package main
+
+import (
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"log"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Cookie bounce: a request without a valid gateway cookie is answered by the
+// gateway itself with a 302 back to the same URL plus a signed cookie. The
+// bounce never reaches the upstream and never enters the queue, so a first
+// visit does not wait behind a crawler flood. The retry carries the cookie and
+// is scheduled as that session (probation applies as for any new session).
+//
+// Token: <id>.<issued unix s>.<hmac>, hmac = first 16 bytes of
+// HMAC-SHA256(secret, id + "." + issued), hex. A forged or edited token fails
+// validation and is treated as cookieless (bounced again), so a client cannot
+// invent sessions or backdate one to skip probation.
+const sidCookie = "fq_sid"
+
+type bouncer struct {
+	enabled bool
+	secret  []byte
+	maxAge  time.Duration
+}
+
+func newBouncer() *bouncer {
+	b := &bouncer{enabled: os.Getenv("BOUNCE") == "1", maxAge: 30 * 24 * time.Hour}
+	if !b.enabled {
+		return b
+	}
+	if s := os.Getenv("BOUNCE_SECRET"); s != "" {
+		b.secret = []byte(s)
+	} else {
+		b.secret = make([]byte, 32)
+		if _, err := rand.Read(b.secret); err != nil {
+			log.Fatal(err)
+		}
+	}
+	log.Printf("cookie bounce enabled")
+	return b
+}
+
+func (b *bouncer) sign(payload string) string {
+	m := hmac.New(sha256.New, b.secret)
+	m.Write([]byte(payload))
+	return hex.EncodeToString(m.Sum(nil)[:16])
+}
+
+// mint returns a fresh signed token issued at now.
+func (b *bouncer) mint(now time.Time) string {
+	raw := make([]byte, 8)
+	if _, err := rand.Read(raw); err != nil {
+		log.Fatal(err)
+	}
+	payload := hex.EncodeToString(raw) + "." + strconv.FormatInt(now.Unix(), 10)
+	return payload + "." + b.sign(payload)
+}
+
+// valid checks the signature and age. It returns the id (used as the session).
+func (b *bouncer) valid(token string, now time.Time) (id string, issued time.Time, ok bool) {
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 {
+		return "", time.Time{}, false
+	}
+	payload := parts[0] + "." + parts[1]
+	if !hmac.Equal([]byte(parts[2]), []byte(b.sign(payload))) {
+		return "", time.Time{}, false
+	}
+	sec, err := strconv.ParseInt(parts[1], 10, 64)
+	if err != nil {
+		return "", time.Time{}, false
+	}
+	issued = time.Unix(sec, 0)
+	if issued.After(now.Add(time.Minute)) || now.Sub(issued) > b.maxAge {
+		return "", time.Time{}, false
+	}
+	return parts[0], issued, true
+}
+
+// session returns the validated session id from the request, or "".
+func (b *bouncer) session(r *http.Request, now time.Time) string {
+	c, err := r.Cookie(sidCookie)
+	if err != nil {
+		return ""
+	}
+	id, _, ok := b.valid(c.Value, now)
+	if !ok {
+		return ""
+	}
+	return id
+}
+
+// exempt reports requests that must not be bounced: anything a cookie-less
+// client legitimately sends (API calls, git over HTTP, static assets, health).
+func exempt(r *http.Request) bool {
+	if r.Method != http.MethodGet && r.Method != http.MethodHead {
+		return true
+	}
+	p := r.URL.Path
+	for _, pre := range []string{"/api/", "/assets/", "/avatars/", "/-/", "/healthz"} {
+		if strings.HasPrefix(p, pre) {
+			return true
+		}
+	}
+	return strings.Contains(p, ".git/") || strings.HasSuffix(p, "/info/refs")
+}
+
+// bounce answers r with a 302 to the same URL and a freshly signed cookie.
+func (b *bouncer) bounce(w http.ResponseWriter, r *http.Request, now time.Time) {
+	http.SetCookie(w, &http.Cookie{
+		Name: sidCookie, Value: b.mint(now), Path: "/", HttpOnly: true,
+		SameSite: http.SameSiteLaxMode, MaxAge: int(b.maxAge.Seconds()),
+	})
+	http.Redirect(w, r, r.URL.RequestURI(), http.StatusFound)
+}
diff --git a/gateway/bounce_test.go b/gateway/bounce_test.go
new file mode 100644
index 0000000..27ca461
--- /dev/null
+++ b/gateway/bounce_test.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func testBouncer() *bouncer {
+	return &bouncer{enabled: true, secret: []byte("test-secret"), maxAge: 24 * time.Hour}
+}
+
+func TestMintValid(t *testing.T) {
+	b := testBouncer()
+	now := time.Now()
+	tok := b.mint(now)
+	id, issued, ok := b.valid(tok, now)
+	if !ok || id == "" || issued.Unix() != now.Unix() {
+		t.Fatalf("valid token rejected: ok=%v id=%q issued=%v", ok, id, issued)
+	}
+}
+
+func TestForgeryRejected(t *testing.T) {
+	b := testBouncer()
+	now := time.Now()
+	tok := b.mint(now)
+	parts := strings.Split(tok, ".")
+	// backdate the issue time (to skip probation) keeping the old signature
+	forged := parts[0] + ".1000000000." + parts[2]
+	if _, _, ok := b.valid(forged, now); ok {
+		t.Fatal("backdated token accepted")
+	}
+	if _, _, ok := b.valid("abc.123.deadbeef", now); ok {
+		t.Fatal("made-up token accepted")
+	}
+	other := &bouncer{enabled: true, secret: []byte("other"), maxAge: 24 * time.Hour}
+	if _, _, ok := other.valid(tok, now); ok {
+		t.Fatal("token from another secret accepted")
+	}
+}
+
+func TestExpiredRejected(t *testing.T) {
+	b := testBouncer()
+	tok := b.mint(time.Now().Add(-48 * time.Hour))
+	if _, _, ok := b.valid(tok, time.Now()); ok {
+		t.Fatal("expired token accepted")
+	}
+}
+
+func TestBounceResponse(t *testing.T) {
+	b := testBouncer()
+	r := httptest.NewRequest("GET", "/poc/redis/blame/main/README.md?x=1", nil)
+	w := httptest.NewRecorder()
+	b.bounce(w, r, time.Now())
+	if w.Code != http.StatusFound {
+		t.Fatalf("status %d", w.Code)
+	}
+	if loc := w.Header().Get("Location"); loc != "/poc/redis/blame/main/README.md?x=1" {
+		t.Fatalf("location %q", loc)
+	}
+	// the cookie it sets must validate and give back a session on retry
+	var c *http.Cookie
+	for _, ck := range w.Result().Cookies() {
+		if ck.Name == sidCookie {
+			c = ck
+		}
+	}
+	if c == nil {
+		t.Fatal("no cookie set")
+	}
+	r2 := httptest.NewRequest("GET", "/poc/redis", nil)
+	r2.AddCookie(c)
+	if b.session(r2, time.Now()) == "" {
+		t.Fatal("retry with bounce cookie has no session")
+	}
+	if b.session(httptest.NewRequest("GET", "/poc/redis", nil), time.Now()) != "" {
+		t.Fatal("cookieless request has a session")
+	}
+}
+
+func TestExempt(t *testing.T) {
+	cases := []struct {
+		method, path string
+		want         bool
+	}{
+		{"GET", "/poc/redis", false},
+		{"GET", "/poc/redis/blame/main/a.go", false},
+		{"POST", "/user/login", true},
+		{"GET", "/api/v1/repos/x", true},
+		{"GET", "/assets/css/index.css", true},
+		{"GET", "/poc/redis.git/info/refs", true},
+		{"GET", "/healthz", true},
+	}
+	for _, c := range cases {
+		r := httptest.NewRequest(c.method, c.path, nil)
+		if got := exempt(r); got != c.want {
+			t.Errorf("%s %s: exempt=%v want %v", c.method, c.path, got, c.want)
+		}
+	}
+}
